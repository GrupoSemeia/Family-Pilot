{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-pilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  // App (pasta app/) + API no mesmo Worker. Só /api/* passa primeiro pelo Worker; o resto é arquivo estático.
  "assets": { "directory": "./app", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Banco criado na conta Cloudflare do Grupo Semeia Digital (migração 0001 já aplicada).
  "d1_databases": [
    { "binding": "DB", "database_name": "family-pilot", "database_id": "d8e9c4ce-912c-4ec5-81a9-cecdde039683", "migrations_dir": "migrations" }
  ],
  // ACESSO_LIVRE: e-mails com acesso liberado sem pagar (equipe, testadores), separados por vírgula.
  // ASAAS_URL: produção. Chave de teste da Asaas ($aact_hmlg_…) usa o sandbox sozinha.
  // PRECOS_MODULOS: preço (em centavos) de cada módulo e do "pacote" (todos os módulos), em JSON. Sem preço, o módulo aparece como "em breve".
  "vars": { "ASAAS_URL": "https://api.asaas.com/v3", "ACESSO_LIVRE": "gruposemeiadigital@gmail.com", "PRECOS_MODULOS": "{\"sono\":3700,\"telas\":3700,\"alimentacao\":3700,\"limites\":3700,\"escola\":3700,\"adolescencia\":4700,\"pacote\":14700}",
    // PRECOS_DE: o preço "de" (cheio) que vai valer depois do lançamento. Aparece riscado ao lado do preço de lançamento.
    // Só coloque aqui valores que você realmente vai cobrar depois. Para não mostrar o "de", deixe "{}".
    "PRECOS_DE": "{\"birra\":9700,\"sono\":7700,\"telas\":7700,\"alimentacao\":7700,\"limites\":7700,\"escola\":7700,\"adolescencia\":9700}",
    // Oferta de boas-vindas: depois de pagar o SOS Birra, o SOS Sono sai por R$ 27 durante 72 horas (uma vez).
    "OFERTA_POS_COMPRA": "{\"modulo\":\"sono\",\"preco\":2700,\"horas\":72}" },
  // segredos (não ficam no código):  npx wrangler secret put ASAAS_API_KEY   e   npx wrangler secret put ASAAS_WEBHOOK_TOKEN
  "observability": { "enabled": true }
}
