{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-pilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  // App (pasta app/) + API no mesmo Worker. Só /api/* passa primeiro pelo Worker; o resto é arquivo estático.
  "assets": { "directory": "./app", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Crie o banco com:  npx wrangler d1 create family-pilot   e cole o database_id abaixo.
  "d1_databases": [
    { "binding": "DB", "database_name": "family-pilot", "database_id": "COLE-AQUI-O-ID-DO-BANCO", "migrations_dir": "migrations" }
  ],
  // ACESSO_LIVRE: e-mails com acesso liberado sem pagar (equipe, testadores), separados por vírgula.
  // ASAAS_URL: produção. Chave de teste da Asaas ($aact_hmlg_…) usa o sandbox sozinha.
  "vars": { "ASAAS_URL": "https://api.asaas.com/v3", "ACESSO_LIVRE": "gruposemeiadigital@gmail.com" },
  // segredos (não ficam no código):  npx wrangler secret put ASAAS_API_KEY   e   npx wrangler secret put ASAAS_WEBHOOK_TOKEN
  "observability": { "enabled": true }
}
